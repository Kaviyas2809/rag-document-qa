# Copy this file to ".env" and fill in your choice. NEVER commit the real .env to GitHub.

# ========== CHOOSE YOUR LLM ==========
# Set LLM_PROVIDER to either "openai" or "ollama"
LLM_PROVIDER=openai

# ---- If LLM_PROVIDER=openai ----
# Get a key at https://platform.openai.com/api-keys  (costs a few cents per run)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- If LLM_PROVIDER=ollama (FREE, runs on your laptop) ----
# Install from https://ollama.com , then run:  ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
